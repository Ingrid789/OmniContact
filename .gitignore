# Keep tests/, rsl_rl/, and asset-loading Python code under version control.

# Python bytecode and packaging
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/

# Local virtual environments
.venv/
venv/
/env/
/ENV/

# Test, coverage, and code-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
/coverage.xml
.ipynb_checkpoints/

# IDE and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local environment, credentials, and assistant settings
.env
.env.*
!.env.example
!.env.template
/.aws/
/.codex/
/.agents/

# Isaac Sim / Omniverse
.cache/
*.dmp
.thumbs/
/_isaac_sim*/
/_repo/
/_build/
.lastformat

